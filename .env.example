# Copy to .env for local runs. On Streamlit Community Cloud, add these as app *secrets* instead.
OPENAI_API_KEY=sk-...

# Optional: protect the public URL with a shared login
APP_USERNAME=
APP_PASSWORD=

# Optional overrides
# LLM_MODEL=gpt-5.4-mini
# LLM_REASONING_EFFORT=medium
# TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
# TRANSCRIBE_LANGUAGE=          # blank = auto-detect (classes are code-mixed)
# CACHE_MAX_GB=5
# FFMPEG_DIR=                   # only if ffmpeg is not on PATH (local Windows)
